# ==============================================================================
# Elemen 2 Weight Tracker — Environment Variables Example
# ==============================================================================
# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local
# For Vercel deployments, add these in your Vercel Project -> Settings -> Environment Variables.

# Supabase Cloud Database Configuration (Free at https://supabase.com)
# Retrieve these from: Supabase Project -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-api-key

# Global Cohort Access Password (Default if omitted: elemen2)
NEXT_PUBLIC_COHORT_PASSWORD=elemen2

# Maintainer Access PIN for logging weigh-ins & edits (Default if omitted: 1234)
NEXT_PUBLIC_MAINTAINER_PASSWORD=1234
